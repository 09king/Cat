      return false;
    }
    currentSound = type;
    store.set("last_sound", type);
    refreshSoundBtns();
    return true;
  }

  function stopSound() {
    noise.stop();
    currentSound = null;
    refreshSoundBtns();
  }

  for (var bi = 0; bi < soundBtns.length; bi++) {
    soundBtns[bi].addEventListener("click", (function (btn) {
      return function () {
        var type = btn.getAttribute("data-sound");
        if (currentSound === type) stopSound();
        else startSound(type);
      };
    })(soundBtns[bi]));
  }

  var vol = $("#vol");
  vol.value = String(Math.round(store.get("vol", 0.6) * 100));
  vol.addEventListener("input", function () {
    var v = parseInt(vol.value, 10) / 100;
    noise.setVolume(v);
    store.set("vol", v);
  });
  noise.setVolume(parseInt(vol.value, 10) / 100);

  $("#mute-btn").addEventListener("click", function () {
    var muted = noise.toggleMute();
    $("#mute-btn").textContent = muted ? "取消静音" : "静音";
  });

  // ========== 整点随机提醒 ==========
  var REMINDERS = [
    "该喝水啦！喵", "起来伸个懒腰嘛！", "眼睛看远一点，保护视力！",
    "猫式伸展，跟我学！", "坐太久啦，走动走动~", "起来倒杯水，顺便摸摸我！",
    "深呼吸三次，放松一下 🌬️", "脖子转一转，别僵住啦"
  ];
  var remindedThisHour = -1;

  function scheduleReminder() {
    var now = new Date();
    var delay = (60 - now.getSeconds()) * 1000 + Math.random() * 8 * 60 * 1000; // 整点后随机 0~8 分钟
    setTimeout(function () {
      var r = REMINDERS[Math.floor(Math.random() * REMINDERS.length)];
      showCatTip(r);
      scheduleReminder();
    }, delay);
  }
  scheduleReminder();

  // ========== 提醒弹窗 ==========
  var overlay = $("#reminder-overlay");
  $("#rb-close").addEventListener("click", function () { overlay.classList.remove("show"); });
  overlay.addEventListener("click", function (e) { if (e.target === overlay) overlay.classList.remove("show"); });

  function showCatTip(msg) {
    $("#cat-tip").textContent = msg;
    $("#rb-text").textContent = msg;
    overlay.classList.add("show");
    clearTimeout(overlay._t);
    overlay._t = setTimeout(function () { overlay.classList.remove("show"); }, 4500);
  }
})();

</script>
</body>
</html>
