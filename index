<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>小猫咪的番茄钟</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }

  :root {
    --card-bg: rgba(255,255,255,0.85);
    --text-dark: #2d3436;
    --accent: #fd79a8;
    --round: 18px;
    --shadow: 0 4px 20px rgba(0,0,0,0.12);
  }

  body {
    font-family: "PingFang SC", "Microsoft YaHei", system-ui, sans-serif;
    min-height: 100vh;
    color: var(--text-dark);
    background: linear-gradient(135deg, #dfe6e9, #ffeaa7);
    transition: background 1.2s ease;
    position: relative;
    overflow-x: hidden;
  }

  body.spring { background: linear-gradient(135deg, #c8f7c5, #fde2a2); }
  body.summer { background: linear-gradient(135deg, #a1c4fd, #c2e9fb); }
  body.autumn  { background: linear-gradient(135deg, #f8c291, #f8a5c2); }
  body.winter  { background: linear-gradient(135deg, #dff6ff, #c8d6e5); }

  body.festival-newyear   { background: linear-gradient(135deg, #ff9a9e, #fad0c4); }
  body.festival-midautumn { background: linear-gradient(135deg, #141e30, #243b55); color: #f5f6fa; }
  body.festival-christmas { background: linear-gradient(135deg, #76b852, #8dc26f); }
  body.festival-halloween { background: linear-gradient(135deg, #654ea3, #eaafc8); }
  body.festival-valentine { background: linear-gradient(135deg, #ee9ca7, #ffdde1); }
  body.festival-national  { background: linear-gradient(135deg, #f7971e, #ffd200); }

  .container {
    max-width: 760px;
    margin: 0 auto;
    padding: 24px 18px 40px;
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  /* ===== 顶部猫咪 ===== */
  .cat-header {
    background: var(--card-bg);
    border-radius: var(--round);
    box-shadow: var(--shadow);
    padding: 14px 22px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 10px;
  }
  .cat-box { display: flex; align-items: center; gap: 14px; }

  .cat {
    width: 66px; height: 66px;
    border-radius: 16px;
    background: #fff center/cover no-repeat;
    box-shadow: 0 2px 8px rgba(0,0,0,0.12);
    cursor: pointer;
    display: inline-block;
    transition: transform 0.15s;
  }
  .cat:active { transform: scale(0.92); }

  #cat-name-line { font-size: 16px; }
  #click-name {
    font-weight: 700;
    color: var(--accent);
    cursor: pointer;
    border-bottom: 2px dashed var(--accent);
    padding: 0 2px;
    font-size: 18px;
  }
  #click-name:hover { background: #ffeaea; }

  #cat-tip {
    font-size: 14px;
    color: #555;
    max-width: 300px;
    background: #fff3cd;
    padding: 5px 11px;
    border-radius: 12px;
    border: 1px solid #ffe58f;
  }

  /* ===== 卡片 ===== */
  .card {
    background: var(--card-bg);
    border-radius: var(--round);
    box-shadow: var(--shadow);
    padding: 22px;
  }
  .card-title {
    font-size: 22px;
    font-weight: 700;
    margin-bottom: 16px;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  /* ===== 番茄钟 ===== */
  .timer-wrap { display: flex; flex-direction: column; align-items: center; }
  .ring {
    position: relative;
    width: 200px; height: 200px;
    margin: 10px 0 18px;
  }
  .ring-circle {
    width: 100%; height: 100%;
    border-radius: 50%;
    background: conic-gradient(var(--accent) 0%, #e0e0e0 0%);
    display: flex; align-items: center; justify-content: center;
    transition: background 0.2s ease;
  }
  .ring-inner {
    width: 170px; height: 170px;
    background: white;
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
  }
  #timer-text { font-size: 46px; font-weight: 700; letter-spacing: 2px; }
  .timer-controls {
    display: flex; flex-wrap: wrap; gap: 10px;
    justify-content: center; margin-top: 6px;
  }
  .btn {
    padding: 10px 18px;
    border: none;
    border-radius: 30px;
    background: var(--accent);
    color: white;
    font-size: 15px;
    cursor: pointer;
    transition: transform 0.1s, opacity 0.2s;
  }
  .btn:hover { opacity: 0.88; transform: scale(1.03); }
  .btn:active { transform: scale(0.96); }
  .btn.secondary { background: #636e72; }
  .btn.outline {
    background: transparent; color: var(--accent);
    border: 2px solid var(--accent);
  }
  .stat-line {
    margin-top: 16px; font-size: 15px; color: #666;
    display: flex; gap: 20px; flex-wrap: wrap; justify-content: center;
  }

  /* ===== 提醒弹窗 ===== */
  #reminder-overlay {
    position: fixed; inset: 0;
    background: rgba(0,0,0,0.45);
    display: none;
    align-items: center; justify-content: center;
    z-index: 999;
  }
  #reminder-overlay.show { display: flex; }
  .reminder-box {
    background: #fff;
    border-radius: 20px;
    padding: 26px 30px;
    max-width: 340px;
    text-align: center;
    box-shadow: 0 10px 40px rgba(0,0,0,0.25);
    animation: pop 0.25s ease;
  }
  @keyframes pop {
    0% { transform: scale(0.8); opacity: 0; }
    100% { transform: scale(1); opacity: 1; }
  }
  .reminder-box .rb-cat {
    width: 90px; height: 90px;
    border-radius: 22px;
    background: #fff center/cover no-repeat;
    margin: 0 auto 14px;
  }
  .reminder-box .rb-text { font-size: 17px; margin-bottom: 18px; line-height: 1.5; }
  .reminder-box .btn { width: 100%; }

  /* ===== Deadline ===== */
  .input-row { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 14px; }
  .input-row input {
    flex: 1; min-width: 150px;
    padding: 10px 14px;
    border: 2px solid #dfe6e9;
    border-radius: 10px;
    font-size: 15px;
    outline: none;
    transition: border 0.2s;
  }
  .input-row input:focus { border-color: var(--accent); }
  #task-list { list-style: none; display: flex; flex-direction: column; gap: 8px; }
  #task-list li {
    background: #fff;
    border: 1px solid #f0f0f0;
    border-radius: 12px;
    padding: 10px 14px;
    display: flex; align-items: center; gap: 10px;
    transition: background 0.2s;
  }
  #task-list li.urgent { background: #ffecec; border-color: #ff7675; }
  #task-list li.done { opacity: 0.55; text-decoration: line-through; }
  #task-list .task-name { flex: 1; }
  #task-list .task-date { font-size: 13px; color: #888; }
  #task-list button { background: none; border: none; font-size: 18px; cursor: pointer; }
  #recent-ddl {
    margin-top: 12px; font-size: 14px; color: #636e72;
    padding: 8px 12px; background: #f1f2f6; border-radius: 10px;
  }

  .footer { text-align: center; font-size: 13px; color: #999; margin-top: 10px; }

  /* ===== 风格切换器 ===== */
  .cat-header .header-right {
    display: flex; align-items: center; gap: 10px; flex-wrap: wrap;
  }
  .style-toggle {
    display: inline-flex; align-items: center;
    background: #f1f2f6; border-radius: 30px; padding: 3px;
    border: 1px solid #e0e0e0;
  }
  .style-toggle button {
    border: none; background: transparent; cursor: pointer;
    padding: 6px 14px; border-radius: 26px; font-size: 14px; color: #636e72;
    transition: all 0.2s;
  }
  .style-toggle button.active {
    background: var(--accent); color: #fff; font-weight: 700;
  }

  /* ===== 白噪音面板 ===== */
  .sound-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
    margin-bottom: 14px;
  }
  .sound-btn {
    border: 2px solid #dfe6e9; background: #fff; border-radius: 14px;
    padding: 14px 6px; cursor: pointer; text-align: center;
    transition: all 0.18s; display: flex; flex-direction: column;
    align-items: center; gap: 6px; font-size: 13px; color: #555;
  }
  .sound-btn:hover { border-color: var(--accent); transform: translateY(-2px); }
  .sound-btn.active {
    border-color: var(--accent); background: #fff0f5; color: var(--accent);
    font-weight: 700;
  }
  .sound-btn .ic { font-size: 26px; }
  .sound-row {
    display: flex; align-items: center; gap: 12px; flex-wrap: wrap;
  }
  .sound-row label { font-size: 14px; color: #636e72; white-space: nowrap; }
  .sound-row input[type=range] { flex: 1; min-width: 140px; accent-color: var(--accent); }
  .sound-hint {
    margin-top: 10px; font-size: 13px; color: #999; line-height: 1.6;
  }
</style>
</head>
<body class="spring">

<div class="container">
  <!-- 顶部猫咪 -->
  <div class="cat-header">
    <div class="cat-box">
      <span class="cat" id="cat" title="摸摸我~"></span>
      <div>
        <div id="cat-name-line"><span id="click-name">小猫咪</span> 的番茄钟 🍅</div>
        <div id="cat-tip" style="margin-top:6px;">喵？</div>
      </div>
    </div>
    <div class="header-right">
      <div class="style-toggle" id="style-toggle">
        <button data-style="watercolor" class="active">🎨 水彩</button>
        <button data-style="cyber">🌃 赛博</button>
      </div>
      <button class="btn outline" id="change-cat" title="换一只猫">换只猫 🔄</button>
    </div>
  </div>

  <!-- 番茄钟 -->
  <div class="card">
    <div class="card-title">🍅 番茄钟</div>
    <div class="timer-wrap">
      <div class="ring">
        <div class="ring-circle" id="ring">
          <div class="ring-inner">
            <span id="timer-text">25:00</span>
          </div>
        </div>
      </div>
      <div class="timer-controls">
        <button class="btn" id="start-btn">开始</button>
        <button class="btn secondary" id="reset-btn">重置</button>
        <button class="btn outline" id="pomodoro-25">25分</button>
        <button class="btn outline" id="short-break-5">5分休</button>
        <button class="btn outline" id="long-break-15">15分休</button>
      </div>
      <div class="stat-line">
        <span>🍅 完成 <strong id="pomodoro-count">0</strong> 个</span>
        <span>⏳ 阶段：<span id="phase-label">专注</span></span>
      </div>
    </div>
  </div>

  <!-- Deadline 看板 -->
  <div class="card">
    <div class="card-title">📋 作业 Deadline</div>
    <div class="input-row">
      <input type="text" id="task-input" placeholder="任务名，如：高数作业" />
      <input type="text" id="date-input" placeholder="日期，如：10-30" />
      <button class="btn" id="add-task">添加</button>
    </div>
    <ul id="task-list"></ul>
    <div id="recent-ddl">最近 DDL：还没有任务</div>
  </div>

  <!-- 专注白噪音 -->
  <div class="card">
    <div class="card-title">🎧 专注白噪音</div>
    <div class="sound-grid">
      <button class="sound-btn" data-sound="rain"><span class="ic">🌧️</span>雨声</button>
      <button class="sound-btn" data-sound="cafe"><span class="ic">☕</span>咖啡馆</button>
      <button class="sound-btn" data-sound="fire"><span class="ic">🔥</span>壁炉</button>
      <button class="sound-btn" data-sound="forest"><span class="ic">🌲</span>森林</button>
    </div>
    <div class="sound-row">
      <label>🔊 音量</label>
      <input type="range" id="vol" min="0" max="100" value="60" />
      <button class="btn outline" id="mute-btn">静音</button>
    </div>
    <div class="sound-hint">
      点一下开始播放，再点一下停止。番茄钟按「开始」时会自动开启上次选的声音，计时结束自动停。写作业时开着，能盖住周围的杂音，更容易沉下来。
    </div>
  </div>

  <p class="footer">小猫咪陪写作业 🐾</p>
</div>

<!-- 随机提醒弹窗 -->
<div id="reminder-overlay">
  <div class="reminder-box">
    <div class="rb-cat" id="rb-cat"></div>
    <div class="rb-text" id="rb-text">该喝水啦！</div>
    <button class="btn" id="rb-close">知道啦</button>
  </div>
</div>

<script>
(function () {
  // 安全的 localStorage 封装（放在最前，确保后续可访问）
var CAT_DATA = {
    watercolor: [
      {id:'orange', name:'橘猫',    emoji:'🍊', img:"'data:image/webp;base64,'"},
      {id:'ragdoll',name:'布偶',    emoji:'🐰', img:"'data:image/webp;base64,'"},
      {id:'tabby',  name:'狸花',    emoji:'🐾', img:"'data:image/webp;base64,'"},
      {id:'black',  name:'黑猫',    emoji:'🌙', img:"'data:image/webp;base64,'"},
      {id:'cow',    name:'奶牛',    emoji:'🥛', img:"'data:image/webp;base64,'"},
      {id:'calico', name:'三花',    emoji:'🌸', img:"'data:image/webp;base64,'"}
    ],
    cyber: [
      {id:'orange', name:'霓虹橘',   emoji:'🍊', img:"'data:image/webp;base64,'"},
      {id:'ragdoll',name:'赛博布偶', emoji:'🐰', img:"'data:image/webp;base64,'"},
      {id:'tabby',  name:'赛博狸花', emoji:'🐾', img:"'data:image/webp;base64,'"},
      {id:'black',  name:'暗影黑猫', emoji:'🌙', img:"'data:image/webp;base64,'"},
      {id:'cow',    name:'像素奶牛', emoji:'🥛', img:"'data:image/webp;base64,'"},
      {id:'calico', name:'全息三花', emoji:'🌸', img:"'data:image/webp;base64,'"}
    ]
  };
  /* ==== 猫咪管理：风格切换 + 随机换猫 ==== */
  var CAT_DATA = {
    watercolor: [
        {id:'orange', name:'橘猫',    emoji:'🍊', img:'data:image/webp;base64,'},
        {id:'ragdoll',name:'布偶',    emoji:'🐰', img:'data:image/webp;base64,'},
        {id:'tabby',  name:'狸花',    emoji:'🐾', img:'data:image/webp;base64,'},
        {id:'black',  name:'黑猫',    emoji:'🌙', img:'data:image/webp;base64,'},
        {id:'cow',    name:'奶牛',    emoji:'🥛', img:'data:image/webp;base64,'},
        {id:'calico', name:'三花',    emoji:'🌸', img:'data:image/webp;base64,'}
    ],
    cyber: [
        {id:'orange', name:'霓虹橘',   emoji:'🍊', img:'data:image/webp;base64,'},
        {id:'ragdoll',name:'赛博布偶', emoji:'🐰', img:'data:image/webp;base64,'},
        {id:'tabby',  name:'赛博狸花', emoji:'🐾', img:'data:image/webp;base64,'},
        {id:'black',  name:'暗影黑猫', emoji:'🌙', img:'data:image/webp;base64,'},
        {id:'cow',    name:'像素奶牛', emoji:'🥛', img:'data:image/webp;base64,'},
        {id:'calico', name:'全息三花', emoji:'🌸', img:'data:image/webp;base64,'}
    ]
    };

(function (global) {
  "use strict";

  // ---------- 程序化音效合成（Web Audio API）----------
  // 不需要任何外部音频文件，全部由数学波形生成，保证单文件离线可用
  function makeNoiseBuffer(ctx, seconds, type) {
    var len = Math.floor(ctx.sampleRate * seconds);
    var buf = ctx.createBuffer(2, len, ctx.sampleRate);
    var ch0 = buf.getChannelData(0);
    var ch1 = len > 0 ? buf.getChannelData(1) : ch0;

    if (type === "rain") {
      // 雨声：白噪声 + 低通滤波 + 随机水滴
      for (var i = 0; i < len; i++) {
        var n = Math.random() * 2 - 1;
        // 简单一阶低通
        ch0[i] = n;
        ch1[i] = n;
      }
    } else if (type === "cafe") {
      // 咖啡馆：粉红噪声（低频更丰富）+ 偶发杯碟声
      var b = 0;
      for (var j = 0; j < len; j++) {
        var white = Math.random() * 2 - 1;
        b = 0.98 * b + 0.02 * white;
        ch0[j] = b * 2.2;
        ch1[j] = b * 2.2;
      }
    } else if (type === "fire") {
      // 壁炉：棕色噪声 + 缓慢闪烁
      var b2 = 0, b3 = 0;
      for (var k = 0; k < len; k++) {
        var w = Math.random() * 2 - 1;
        b2 = 0.02 * w + 0.98 * b2;
        b3 = 0.02 * w + 0.98 * b3;
        ch0[k] = b2 * 3;
        ch1[k] = b3 * 3;
      }
    } else {
      // 森林：低频嗡鸣 + 鸟鸣点缀
      for (var m = 0; m < len; m++) {
        var t = m / ctx.sampleRate;
        var bird = 0;
        // 随机鸟鸣
        if (Math.random() < 0.0003) {
          bird = Math.sin(2 * Math.PI * (800 + Math.random() * 1200) * t) * 0.3;
        }
        var buzz = Math.sin(2 * Math.PI * 120 * t) * 0.15;
        ch0[m] = buzz + bird;
        ch1[m] = buzz + bird;
      }
    }
    return buf;
  }

  // 生成一杯水倒下的清脆声（用于咖啡馆杯碟声）
  function cupClink(ctx) {
    var o = ctx.createOscillator();
    var g = ctx.createGain();
    o.type = "sine";
    o.frequency.setValueAtTime(2400, ctx.currentTime);
    o.frequency.exponentialRampToValueAtTime(1800, ctx.currentTime + 0.12);
    g.gain.setValueAtTime(0.0001, ctx.currentTime);
    g.gain.exponentialRampToValueAtTime(0.18, ctx.currentTime + 0.005);
    g.gain.exponentialRampToValueAtTime(0.0001, ctx.currentTime + 0.2);
    o.connect(g);
    g.connect(ctx.destination);
    o.start();
    o.stop(ctx.currentTime + 0.22);
  }

  function NoiseEngine() {
    this.ctx = null;
    this.current = null;     // 当前声音类型
    this.gainNode = null;
    this.noiseGain = null;
    this.filter = null;
    this.source = null;
    this.volume = 0.6;
    this.timer = null;
    this.muted = false;
  }

  NoiseEngine.prototype._ensureCtx = function () {
    if (!this.ctx) {
      var AC = global.AudioContext || global.webkitAudioContext;
      if (!AC) return false;
      this.ctx = new AC();
    }
    if (this.ctx.state === "suspended") {
      this.ctx.resume();
    }
    return true;
  };

  NoiseEngine.prototype._stopSource = function () {
    if (this.source) {
      try { this.source.stop(); } catch (e) {}
      try { this.source.disconnect(); } catch (e) {}
      this.source = null;
    }
    if (this.filter) { try { this.filter.disconnect(); } catch (e) {} this.filter = null; }
    if (this.noiseGain) { try { this.noiseGain.disconnect(); } catch (e) {} this.noiseGain = null; }
    if (this.gainNode) { try { this.gainNode.disconnect(); } catch (e) {} this.gainNode = null; }
    if (this.timer) { clearInterval(this.timer); this.timer = null; }
  };

  NoiseEngine.prototype.play = function (type) {
    if (!this._ensureCtx()) return false;
    this._stopSource();
    this.current = type;
    this.muted = false;

    var ctx = this.ctx;
    // 生成 4 秒缓冲并循环，足够长避免循环感
    var buffer = makeNoiseBuffer(ctx, 4, type);
    var src = ctx.createBufferSource();
    src.buffer = buffer;
    src.loop = true;

    var noiseGain = ctx.createGain();
    noiseGain.gain.value = 0.9;

    // 不同声音用不同滤波
    var filter = ctx.createBiquadFilter();
    if (type === "rain") {
      filter.type = "lowpass";
      filter.frequency.value = 2200;
    } else if (type === "cafe") {
      filter.type = "bandpass";
      filter.frequency.value = 900;
      filter.Q.value = 0.6;
    } else if (type === "fire") {
      filter.type = "lowpass";
      filter.frequency.value = 700;
    } else if (type === "forest") {
      filter.type = "lowpass";
      filter.frequency.value = 1600;
    }

    var masterGain = ctx.createGain();
    masterGain.gain.value = this.volume;

    src.connect(noiseGain);
    noiseGain.connect(filter);
    filter.connect(masterGain);
    masterGain.connect(ctx.destination);

    src.start();

    this.source = src;
    this.noiseGain = noiseGain;
    this.filter = filter;
    this.gainNode = masterGain;

    // 咖啡馆偶尔加杯碟声
    var self = this;
    if (type === "cafe") {
      this.timer = setInterval(function () {
        if (self.ctx && self.ctx.state === "running" && !self.muted) {
          cupClink(self.ctx);
        }
      }, 6000 + Math.random() * 5000);
    }

    // 音量渐入，避免点击声
    masterGain.gain.setValueAtTime(0, ctx.currentTime);
    masterGain.gain.linearRampToValueAtTime(this.volume, ctx.currentTime + 0.6);
    return true;
  };

  NoiseEngine.prototype.stop = function () {
    if (!this.gainNode || !this.ctx) {
      this._stopSource();
      return;
    }
    var self = this;
    var g = this.gainNode;
    var ctx = this.ctx;
    try {
      g.gain.cancelScheduledValues(ctx.currentTime);
      g.gain.setValueAtTime(g.gain.value, ctx.currentTime);
